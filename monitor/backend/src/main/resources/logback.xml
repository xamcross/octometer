<!-- A console log and a rolling file log (issue #57). ERROR goes to the -->
<!-- standard error, so a scheduled task that captures only that stream -->
<!-- still records a fatal start-up error (D2). The distribution also -->
<!-- runs in a console window, and the CI reads the console; the two -->
<!-- console appenders stay for that reader. -->
<configuration>
    <!-- The logs folder of D3 and D34, a sibling of dataDir. Application.kt
         sets this property after loadConfig returns, then it runs
         JoranConfigurator on this same file (see the class comment of
         Application.kt for the reason and the two lines that keep the
         default below). The default lets this file appender work at
         the very first log call too, before the config load, and in a
         test that never sets the property. -->
    <property name="OCTOMETER_LOG_DIR" value="${OCTOMETER_LOG_DIR:-build/logs}" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
        <target>System.out</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The rolling file log of issue #57, design decision D37. The
         pattern text is the exact text of the two console appenders
         above: [%thread] holds a fixed name of the app, never a value
         (the maintainer's correction of the brief review). The policy
         properties follow the Logback manual, page
         "appenders-rolling.html", section SizeAndTimeBasedRollingPolicy,
         read on 2026-09-27: fileNamePattern needs both %d and %i;
         maxFileSize rolls a file over within one day; maxHistory and
         totalSizeCap bound the age and the total size of the archive
         together; cleanHistoryOnStart applies the two bounds at the
         start too, for a short-lived run. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${OCTOMETER_LOG_DIR}/octometer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${OCTOMETER_LOG_DIR}/octometer.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Issue #150: StatusPages writes a TRACE line with the full request
         URL. The line holds the query string too. This happens for a
         response with no status handler. It also happens for a response
         with no status set at all. A status() handler cannot close the
         second case, because no status code exists yet at that point.
         StatusPagesTraceTest proves this claim. The level OFF stops the
         line at each level, also when a diagnosis raises the root level
         to TRACE. -->
    <logger name="io.ktor.server.plugins.statuspages.StatusPages" level="OFF" />

    <!-- Pull request #170 review, BLOCKER 1: ContentNegotiation also
         writes a TRACE line with the full request URI. The source is
         ResponseConverter.kt of ktor-server-content-negotiation. Each
         call sits at the TRACE level. One call names the URI in its
         text. Two calls name the response body object in its text. A
         body of the level 2 route holds each user id of a page. The
         level OFF stops each of these lines too. -->
    <logger name="io.ktor.server.plugins.contentnegotiation.ContentNegotiation" level="OFF" />

    <!-- Pull request #170 review, MAJOR 2: io.ktor.server.routing.Routing
         writes a TRACE line for each request, on a real Netty server, in
         each mode. This happens when the root level is at TRACE before
         the server starts. The line names each path segment. It also
         names the value of a path parameter. No route of the monitor
         holds a user id in a path segment today. D13 keeps the user id,
         the session id, and firstPath in the query string. A later
         route with a user id in a path segment needs this logger at OFF
         too. -->

    <!-- MAJOR 1, security review of pull request #160. The MongoDB driver -->
    <!-- writes the user name and the host into an INFO line, and the -->
    <!-- credential of a MongoSecurityException into a DEBUG line. Design -->
    <!-- decision D11 forbids a connection string in a log line. WARN keeps -->
    <!-- each of these lines out of the log, and it still shows a real -->
    <!-- driver problem. -->
    <logger name="org.mongodb" level="WARN" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="STDERR" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
