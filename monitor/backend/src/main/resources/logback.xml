<!-- A minimal console log. Issue #57 adds the file log with rotation. -->
<!-- ERROR goes to the standard error, so a scheduled task that captures -->
<!-- only that stream still records a fatal start-up error (D2). -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
        <target>System.out</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Issue #150: this plugin writes a TRACE line with the full request
         URL, so it holds the query string too. This runs for a response
         with no registered status handler, and for a response with no
         status set at all, thus a handler for one status cannot close the
         line for every route (proof: StatusPagesTraceTest and the
         evidence in the pull request text). The level OFF stops the line
         at each level, also when a diagnosis raises the root level to
         TRACE. -->
    <logger name="io.ktor.server.plugins.statuspages.StatusPages" level="OFF" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="STDERR" />
    </root>
</configuration>
