{
  "name": "octometer-tracker",
  "version": "0.1.0",
  "description": "The click tracker of Octometer. It sends a click on a data-octo element to the ingest route.",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/path-match.ts",
    "src/batch.ts",
    "README.md"
  ],
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {},
  "devDependencies": {
    "jsdom": "^30.1.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
