{
  "name": "octometer-tracker",
  "version": "0.3.0",
  "description": "The click tracker of Octometer. It sends a click on a data-octo element to the ingest route.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/index.ts",
    "src/iife.ts",
    "src/path-match.ts",
    "src/batch.ts",
    "src/referrer-source.ts",
    "README.md"
  ],
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.types.json && npm run build:iife && node scripts/print-iife-size.mjs",
    "build:iife": "esbuild src/iife.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/tracker.iife.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.2"
  }
}
